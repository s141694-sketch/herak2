# Harak's configuration for a deployment with docker compose (the pilot; task 8.6). Copy it to backend/.env on the
# server, fill in every "required" value, and keep the file out of git (it holds the secrets). The runbook,
# docs/2026-10-06-harak2-runbook.md, says how to deploy with it:
#
#   docker compose --env-file backend/.env -f infra/docker-compose.yml up -d
#
# Every service reads this file, and compose takes HARAK_DOMAIN and POSTGRES_PASSWORD from it as well. Values with
# no quotes; avoid "$" in them (compose may read it as a variable). Random values: the commands beside each.
# Compose sets these itself, whatever this file says: DJANGO_SETTINGS_MODULE (production), DATABASE_URL and
# REDIS_URL (its own postgres and redis), COLLAB_INTERNAL_URL, DJANGO_INTERNAL_URL, NUM_PROXIES (2: caddy and nginx).

# --- The address (required) ----------------------------------------------------------------------------------------
# The public name people open Harak at. Its DNS record points at this server, and ports 80 and 443 reach it: caddy
# gets the certificate for it and renews it on its own (D88).
HARAK_DOMAIN=harak.example.com
# The same name, as Django checks it. "backend" stays: the collaboration service calls Django by that name.
ALLOWED_HOSTS=harak.example.com,backend
CSRF_TRUSTED_ORIGINS=https://harak.example.com
# Where links in emails lead (invitations, new passwords, notifications), and where identity providers return.
APP_URL=https://harak.example.com
# Only for a provider that must return elsewhere than APP_URL/api/auth/sso/callback/; usually empty.
SSO_CALLBACK_URL=

# --- Secrets (required) --------------------------------------------------------------------------------------------
# Production refuses to start with SECRET_KEY or COLLAB_* short or left as examples, and with FIELD_ENCRYPTION_KEYS
# empty, not a key, or one from git. POSTGRES_PASSWORD's length is not checked (compose refuses only an empty one):
# make it the same way. Each: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
COLLAB_TOKEN_SECRET=
COLLAB_SERVICE_SECRET=
# The database password of compose's postgres, chosen once, before the first start (the volume keeps it after):
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
# Encryption of stored secrets (two-factor secrets, identity providers' client secrets; D64). Losing it loses them;
# keep a copy apart from the backups. Generate:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# To change it: put the new key first and keep the old after a comma, then run
# "python manage.py rotate_field_encryption" in the backend; the old key may then go.
FIELD_ENCRYPTION_KEYS=

# --- Email (required for invitations, new passwords and notifications; D59) ----------------------------------------
# Any SMTP provider: smtp+tls://user:password@host:587 (STARTTLS), or smtp+ssl://user:password@host:465.
# A user or password with "@", ":" or "/" in it is percent-encoded (%40, %3A, %2F).
EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
DEFAULT_FROM_EMAIL=Harak <no-reply@harak.example.com>

# --- Stored files (required: imports' files, logos, exported Word and PDF; D75) ------------------------------------
# An S3-compatible bucket, private, with encryption at rest at the provider. The endpoint is empty for AWS itself,
# or the provider's address for another (https://...). The keys may stay empty where the server is given its own
# credentials (an instance role).
FILES_BUCKET=
FILES_ENDPOINT_URL=
FILES_PUBLIC_ENDPOINT_URL=
FILES_ACCESS_KEY_ID=
FILES_SECRET_ACCESS_KEY=
FILES_REGION=
# How long a download link lasts, in seconds.
FILES_LINK_SECONDS=60
# True only for a store that starts empty with Harak (a test); a real bucket is made at the provider.
FILES_CREATE_BUCKET=False

# --- Monitoring (strongly recommended; spec 7.5) -------------------------------------------------------------------
# Errors and their traces go to Sentry when set; without it, only to the logs. Sentry gets no cookies, addresses or
# user details (send_default_pii is off), though a trace may still show values from the code that failed.
SENTRY_DSN=
SENTRY_ENVIRONMENT=pilot
# JSON logs (one event per line) for a log collector; LOG_LEVEL INFO, or WARNING for less.
LOG_JSON=True
LOG_LEVEL=INFO

# --- AI (optional; D37) --------------------------------------------------------------------------------------------
# Without a key, or with AI_PROVIDER empty, Harak runs on its rules only. The agents stay off for the pilot until
# the owner sets their accuracy thresholds and the golden set exists (phase 4 plan, section 5): leave the key empty
# until then.
ANTHROPIC_API_KEY=
AI_PROVIDER=claude
# AI_MODEL: the provider's model; unset, the settings' default.
AI_MONTHLY_TOKEN_QUOTA=2000000
AI_TIMEOUT_SECONDS=60
AI_MAX_ATTEMPTS=3
AI_BACKOFF_SECONDS=1
QUALITY_AI_DELAY_SECONDS=60
QUALITY_STALE_RUN_MINUTES=30
# Recordings of AI calls for the golden set's tooling (evals/); empty in production.
AI_RECORDINGS_DIR=

# --- Backups (D83) -------------------------------------------------------------------------------------------------
# Compose's backup service writes to its "backups" volume each day; mount that volume off this server (runbook).
BACKUP_KEEP_DAYS=14
BACKUP_SECONDS=3600
BACKUP_PG_DUMP=pg_dump
BACKUP_PG_RESTORE=pg_restore
BACKUP_DIR=

# --- Limits (the defaults suit a pilot; change them only for a reason) ---------------------------------------------
# A browser session, in seconds (8 hours). Sign-ins through a provider follow the organization's own setting.
SESSION_COOKIE_AGE=28800
# Requests per signed-in person, and sign-ins and provider sign-ins per address.
USER_THROTTLE_RATE=600/minute
LOGIN_THROTTLE_RATE=10/minute
SSO_THROTTLE_RATE=30/minute
# Uploads kept per person (an import's file, a logo; D80).
UPLOAD_THROTTLE_RATE=60/hour
# Wrong passwords for one account before its password sign-in pauses, and for how long (D84).
LOGIN_ACCOUNT_FAILURES=10
LOGIN_ACCOUNT_PAUSE_MINUTES=15
# One email with a link to choose a new password per address in this many minutes ("Forgot your password?").
PASSWORD_RESET_EMAIL_MINUTES=5
# A curriculum uploaded for an import: size, pages, size once unpacked (Word), and the reading's time and memory.
IMPORT_MAX_FILE_BYTES=10485760
IMPORT_MAX_PAGES=300
IMPORT_MAX_UNPACKED_BYTES=52428800
IMPORT_EXTRACT_SECONDS=20
IMPORT_EXTRACT_MEMORY_MB=1024
# The PDF of an approved program, made by LibreOffice within this many seconds.
EXPORT_SOFFICE=soffice
EXPORT_PDF_SECONDS=120
# The collaboration service: a live editing token's life, and how long Django waits for the service.
COLLAB_TOKEN_TTL_SECONDS=120
COLLAB_TIMEOUT_SECONDS=10
COLLAB_SNAPSHOT_TIMEOUT_SECONDS=3
COLLAB_SAVE_MAX_BYTES=67108864
# Database connections kept between requests, in seconds.
DB_CONN_MAX_AGE=60

# --- Outbound proxy --------------------------------------------------------------------------------------------------
# Leave HTTP_PROXY and HTTPS_PROXY unset unless the network needs them: behind an outbound proxy the address a
# connection to an identity provider reached is not checked, only the address its name resolved to (D84).

# --- Never in production -------------------------------------------------------------------------------------------
# These exist for development and tests; production refuses the first two when true.
SSO_ALLOW_HTTP_ISSUERS=False
SSO_ALLOW_PRIVATE_ADDRESSES=False
CELERY_TASK_ALWAYS_EAGER=False
DEBUG=False
# Not used by the compose deployment (the web client and API share one address).
CORS_ALLOWED_ORIGINS=
