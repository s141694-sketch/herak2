# In a GitHub Codespace (D99), in place of Caddy: GitHub's port forwarding ends TLS, then this hands nginx the
# request as Caddy would on a server. The public name and https are set here rather than taken from whatever
# GitHub's proxy sends, so Django sees the address people open, whatever the proxy's headers.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

# GitHub's port forwarding also rewrites the browser's Origin to https://localhost:8000, which Django's CSRF check
# rejects (D102). That one value goes back to the public address; any other Origin passes on as sent. The CSRF token
# and the SameSite session cookie still guard every write.
map $http_origin $public_origin {
    default                  $http_origin;
    "https://localhost:8000" "https://${HARAK_DOMAIN}";
    "http://localhost:8000"  "https://${HARAK_DOMAIN}";
}

resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 3s;

upstream frontend {
    zone frontend 64k;
    server frontend:80 resolve;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 11m;

    # Every visit reaches this container from the same local address (GitHub's forwarder, then Docker's port). The
    # client is the last address GitHub's forwarder adds to X-Forwarded-For, if it adds one; only that one address
    # goes on to nginx, as Caddy does on a server, so rate limits count people, not the forwarder (D99 review).
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.0/8;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    location / {
        proxy_pass http://frontend;
        proxy_http_version 1.1;
        proxy_set_header Host ${HARAK_DOMAIN};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Origin $public_origin;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Live editing keeps its WebSocket open.
        proxy_read_timeout 1h;
    }
}
