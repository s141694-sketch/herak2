# In a GitHub Codespace (D99), in place of Caddy: GitHub's port forwarding ends TLS, then this hands nginx the
# request as Caddy would on a server. The public name and https are set here rather than taken from whatever
# GitHub's proxy sends, so Django sees the address people open, whatever the proxy's headers.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 3s;

upstream frontend {
    zone frontend 64k;
    server frontend:80 resolve;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 11m;

    location / {
        proxy_pass http://frontend;
        proxy_http_version 1.1;
        proxy_set_header Host ${HARAK_DOMAIN};
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Live editing keeps its WebSocket open.
        proxy_read_timeout 1h;
    }
}
