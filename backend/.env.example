# Copy to backend/.env for local development. Never commit real secrets.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://harak:harak@127.0.0.1:5432/harak
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
LOG_JSON=False
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Collaboration service secrets: long random strings, the same values in the collab service.
COLLAB_TOKEN_SECRET=change-me
COLLAB_SERVICE_SECRET=change-me
COLLAB_INTERNAL_URL=http://127.0.0.1:1234
