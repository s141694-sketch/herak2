# Copy to backend/.env for local development. Never commit real secrets.
SECRET_KEY=change-me
DEBUG=True
# "backend" is the host the collaboration service calls Django on inside docker compose.
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgres://harak:harak@127.0.0.1:5432/harak
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
LOG_JSON=False
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Collaboration service secrets: long random strings, the same values in the collab service.
COLLAB_TOKEN_SECRET=change-me
COLLAB_SERVICE_SECRET=change-me
COLLAB_INTERNAL_URL=http://127.0.0.1:1234
# AI gateway (D37). Without ANTHROPIC_API_KEY the product runs on rules only. Keep the key out of git.
ANTHROPIC_API_KEY=
AI_PROVIDER=claude
AI_MODEL=claude-opus-5-5
AI_MONTHLY_TOKEN_QUOTA=2000000
# Email (D59): any SMTP provider, e.g. smtp+tls://user:password@smtp.example.com:587. Empty: printed to the console.
# EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
DEFAULT_FROM_EMAIL=Harak <no-reply@example.com>
# Where links in notification emails lead.
APP_URL=http://localhost:5173
# Encryption of stored secrets (D64): comma-separated Fernet keys, the first encrypts. Generate one with
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())". Keep them out of git.
FIELD_ENCRYPTION_KEYS=
# Proxies in front of Django that append to X-Forwarded-For (1: the nginx of infra/, as shipped). Rate limits then
# count the address that proxy saw. Set 0 only when clients reach Django directly.
NUM_PROXIES=1
# Stored files (D75): any S3-compatible store (a cloud bucket, or one run beside Harak). Leave the endpoint empty
# for the cloud provider's own; FILES_PUBLIC_ENDPOINT_URL is the address browsers reach, when it differs. The keys
# may stay empty where the platform gives the server its credentials. Download links last FILES_LINK_SECONDS.
FILES_BUCKET=harak2-files
FILES_ENDPOINT_URL=
FILES_PUBLIC_ENDPOINT_URL=
FILES_ACCESS_KEY_ID=
FILES_SECRET_ACCESS_KEY=
FILES_REGION=us-east-1
FILES_LINK_SECONDS=60
